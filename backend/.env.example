# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key. The backend is the only thing that talks to the database.
SUPABASE_KEY=

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Swap the model by changing this one line. Leave blank until you pick one.
# Examples: deepseek/deepseek-chat  openai/gpt-4o-mini  google/gemini-2.0-flash-001
OPENROUTER_MODEL=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2000
# Optional headers OpenRouter uses for rankings. Safe to leave as-is.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Note-taking app

# Comma-separated. Add your Vercel URL when you deploy.
CORS_ORIGINS=http://localhost:5173
